# =============================================================================
# CONCLAVE INTERIORS ATELIER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit real credentials to git.
# =============================================================================

# SERVER RUNTIME
PORT=3000
NODE_ENV=production
APP_URL=https://your-app-name.onrender.com

# DATABASE CONNECTION (PostgreSQL on Render / Neon)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# POSTGRESQL ADMIN SESSION AUTHENTICATION
# Admin identity is controlled by ADMIN_EMAIL. Auth will fail-closed if ADMIN_EMAIL is missing.
ADMIN_EMAIL=conclaveinteriorexterior@gmail.com
# Initial password for bootstrapping the administrator account in PostgreSQL (only used when account has no password set; min 12 chars in production)
ADMIN_INITIAL_PASSWORD=GenerateStrongUniqueAdminPassword123!
# Cryptographic secret for signing session cookies (REQUIRED in production, minimum 32 characters)
SESSION_SECRET=generate_a_random_32_character_hex_or_base64_secret_here

# =============================================================================
# COMMISSION INQUIRY EMAIL DELIVERY
# =============================================================================
# Destination inbox where incoming client commission briefs are sent:
ENQUIRY_NOTIFICATION_EMAIL=conclaveinteriorexterior@gmail.com

# -----------------------------------------------------------------------------
# OPTION A: HTTPS Transactional Email API (RECOMMENDED for Render Free & Production)
# Render Free blocks outbound SMTP ports 25, 465, and 587. Resend communicates
# over standard HTTPS (port 443), ensuring reliable delivery on free cloud hosts.
# -----------------------------------------------------------------------------
# 1. Sign up at https://resend.com and generate an API key (e.g. re_xxxx...).
# 2. For instant testing, you can use the default sandbox sender:
#    RESEND_FROM_EMAIL='Conclave Interiors <onboarding@resend.dev>'
#    (Note: onboarding@resend.dev can only deliver to the email you registered on Resend).
# 3. For live production to any recipient:
#    Add & verify your domain in Resend DNS (e.g. mail.yourstudio.com), then set:
#    RESEND_FROM_EMAIL='Conclave Atelier <inquiries@yourstudio.com>'
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Conclave Interiors <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# OPTION B: SMTP Transport (Optional Fallback for Local Development)
# Used only if RESEND_API_KEY is not defined. (Will NOT work on Render Free).
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=conclaveinteriorexterior@gmail.com
SMTP_PASS=your-16-char-google-app-password


