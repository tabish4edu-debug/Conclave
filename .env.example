# =============================================================================
# CONCLAVE INTERIORS ATELIER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit real credentials to git.
# =============================================================================

# SERVER RUNTIME
PORT=3000
NODE_ENV=production
APP_URL=https://your-app-name.onrender.com

# DATABASE CONNECTION (PostgreSQL on Render / Neon / Cloud SQL)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# FIREBASE AUTH & ADMIN SDK (Server-Side Token Verification)
# Production auth will fail-closed if ADMIN_EMAIL is missing.
ADMIN_EMAIL=admin@yourdomain.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# CLIENT-SIDE VITE VARIABLES (Safe for browser injection)
VITE_FIREBASE_API_KEY=your-client-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-client-app-id
